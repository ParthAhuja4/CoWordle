# Discord application (Developer Portal → your app)
DISCORD_TOKEN=            # Bot → Token
CLIENT_ID=                # General Information → Application ID
DISCORD_CLIENT_SECRET=    # OAuth2 → Client Secret (needed to sign players into the Activity)
GUILD_ID=                 # optional: register /stats /leaderboard /help to one server instantly (dev)

# MongoDB Atlas connection string. Optional: without it games work but nothing is recorded.
MONGODB_URI=
MONGODB_DB=cowordle

# Default seconds per guess (Duel) / per turn (Turn-by-Turn). The host can change it per room. Default 70.
TURN_SECONDS=70

# Port for the Activity web server. Render sets PORT automatically. Default 3000.
PORT=3000

# Development only: lets http://localhost:3000/?dev=Alice&instance=room1 play without Discord.
# NEVER set this on a public host.
ALLOW_DEV_LOGIN=0
